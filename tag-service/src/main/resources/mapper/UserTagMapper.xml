<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeuslu.blog.tag.mapper.UserTagMapper">
    <select id="selectTagsByUserId" resultType="java.lang.String">
        select
            tb_tag.name
        from tb_tag join tb_user_tag on tb_tag.id = tb_user_tag.tag_id
        where tb_user_tag.user_id = #{userId}
    </select>
</mapper>
