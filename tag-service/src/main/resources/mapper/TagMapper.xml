<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zeuslu.blog.tag.mapper.TagMapper">
    <select id="selectArticleIdsByTagNames" resultType="java.lang.Long">
        select
            article_id
        from
            tb_tag join tb_article_tag
        on
            tb_tag.id = tb_article_tag.tag_id
        <where>
            tb_tag.name in
            <foreach collection="tags" item="tag" separator="," open="(" close=")">
                #{tag}
            </foreach>
        </where>
    </select>
    <select id="selectTagsByArticleId" resultType="java.lang.String">
        select
            tb_tag.name
        from
            tb_article_tag join tb_tag
        on
            tb_article_tag.tag_id = tb_tag.id
        where
            tb_article_tag.article_id = #{articleId}
    </select>
</mapper>
